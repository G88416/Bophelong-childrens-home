rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: only authenticated users may access data
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if the requesting user has the admin role
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Children records
    match /children/{childId} {
      allow read, write: if isAuthenticated();
    }

    // Medical records
    match /medical/{recordId} {
      allow read, write: if isAuthenticated();
    }

    // Vaccination records
    match /vaccines/{recordId} {
      allow read, write: if isAuthenticated();
    }

    // Staff records
    match /staff/{staffId} {
      allow read, write: if isAuthenticated();
    }

    // Donation records
    match /donations/{donationId} {
      allow read, write: if isAuthenticated();
    }

    // Funder engagement records
    match /funders/{funderId} {
      allow read, write: if isAuthenticated();
    }

    // Adoption records
    match /adoptions/{adoptionId} {
      allow read, write: if isAuthenticated();
    }

    // Events
    match /events/{eventId} {
      allow read, write: if isAuthenticated();
    }

    // Inventory items
    match /inventory/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // Finance – income records
    match /income/{recordId} {
      allow read, write: if isAuthenticated();
    }

    // Finance – expense records
    match /expenses/{recordId} {
      allow read, write: if isAuthenticated();
    }

    // User profiles and roles
    // - Any authenticated user can read all profiles (needed for role lookup)
    // - A user can create/update their own profile (first login auto-creation)
    // - Admins can create, update, or delete any user profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Organisation settings (single document per key)
    match /settings/{key} {
      allow read, write: if isAuthenticated();
    }
  }
}
